<UserControl x:Class="OpenClick.App.Views.FilterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="4">
      <TextBlock x:Name="TitleText" Style="{StaticResource H1}" Margin="0,0,0,12"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <CheckBox x:Name="EnabledCheck" Checked="EnabledCheck_Changed" Unchecked="EnabledCheck_Changed"/>
          <TextBlock x:Name="ModeLabel" Style="{StaticResource Body}" Margin="0,10,0,4"/>
          <ComboBox x:Name="ModeCombo" SelectionChanged="Config_Changed" Margin="0,0,0,8"/>
          <TextBlock x:Name="IntervalLabel" Style="{StaticResource Body}" Margin="0,4,0,4"/>
          <ComboBox x:Name="PresetCombo" SelectionChanged="PresetCombo_Changed" Margin="0,0,0,8"/>
          <StackPanel Orientation="Horizontal">
            <TextBox x:Name="CustomIntervalBox" Width="120"/>
            <Button x:Name="ApplyIntervalButton" Click="ApplyIntervalButton_Click" Margin="8,0,0,0"/>
          </StackPanel>
          <TextBlock x:Name="WarnLong" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
          <TextBlock x:Name="DragNote" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
          <TextBlock x:Name="HookErrorText" Foreground="{StaticResource DangerBrush}" Style="{StaticResource MutedText}" Visibility="Collapsed" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock x:Name="ButtonsTitle" Style="{StaticResource H2}" Margin="0,0,0,8"/>
          <CheckBox x:Name="LeftCheck" Checked="Config_Changed" Unchecked="Config_Changed"/>
          <CheckBox x:Name="RightCheck" Checked="Config_Changed" Unchecked="Config_Changed"/>
          <CheckBox x:Name="MiddleCheck" Checked="Config_Changed" Unchecked="Config_Changed"/>
          <CheckBox x:Name="X1Check" Checked="Config_Changed" Unchecked="Config_Changed"/>
          <CheckBox x:Name="X2Check" Checked="Config_Changed" Unchecked="Config_Changed"/>
          <TextBlock x:Name="BypassLabel" Style="{StaticResource Body}" Margin="0,10,0,4"/>
          <TextBox x:Name="BypassProcessBox" Margin="0,0,0,4"/>
          <TextBlock x:Name="UipiNote" Style="{StaticResource MutedText}"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
