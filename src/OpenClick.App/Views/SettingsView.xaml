<UserControl x:Class="OpenClick.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="4">
      <TextBlock x:Name="TitleText" Style="{StaticResource H1}" Margin="0,0,0,12"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock x:Name="AppearanceTitle" Style="{StaticResource H2}" Margin="0,0,0,8"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="DarkButton" Click="DarkButton_Click" MinWidth="100"/>
            <Button x:Name="LightButton" Click="LightButton_Click" MinWidth="100" Margin="8,0,0,0" Style="{StaticResource GhostButton}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="EnglishButton" Click="EnglishButton_Click" MinWidth="100"/>
            <Button x:Name="ArabicButton" Click="ArabicButton_Click" MinWidth="100" Margin="8,0,0,0" Style="{StaticResource GhostButton}"/>
          </StackPanel>
          <CheckBox x:Name="CompactCheck" Checked="CompactCheck_Changed" Unchecked="CompactCheck_Changed" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock x:Name="HotkeyTitle" Style="{StaticResource H2}" Margin="0,0,0,8"/>
          <TextBlock Text="Toggle hotkey (e.g. Ctrl+Alt+M)" Style="{StaticResource Body}"/>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBox x:Name="HotkeyBox" Width="180"/>
            <Button x:Name="ApplyHotkeyButton" Click="ApplyHotkeyButton_Click" Margin="8,0,0,0"/>
          </StackPanel>
          <CheckBox x:Name="StartEnabledCheck" Margin="0,8,0,0" Checked="StartEnabledCheck_Changed" Unchecked="StartEnabledCheck_Changed"/>
          <TextBlock x:Name="ThresholdLabel" Style="{StaticResource Body}" Margin="0,8,0,4"/>
          <StackPanel Orientation="Horizontal">
            <TextBox x:Name="ThresholdBox" Width="100"/>
            <TextBox x:Name="HistoryBox" Width="100" Margin="8,0,0,0"/>
            <Button x:Name="ApplyTesterButton" Click="ApplyTesterButton_Click" Margin="8,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock x:Name="SystemTitle" Style="{StaticResource H2}" Margin="0,0,0,8"/>
          <CheckBox x:Name="StartWithWindowsCheck" Checked="StartWithWindowsCheck_Changed" Unchecked="StartWithWindowsCheck_Changed"/>
          <CheckBox x:Name="StartMinimizedCheck" Checked="SimpleSave_Changed" Unchecked="SimpleSave_Changed"/>
          <CheckBox x:Name="MinimizeToTrayCheck" Checked="SimpleSave_Changed" Unchecked="SimpleSave_Changed"/>
          <CheckBox x:Name="CloseToTrayCheck" Checked="SimpleSave_Changed" Unchecked="SimpleSave_Changed"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="OpenFolderButton" Click="OpenFolderButton_Click" Style="{StaticResource GhostButton}"/>
            <Button x:Name="ExportLogsButton" Click="ExportLogsButton_Click" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
            <Button x:Name="ResetButton" Click="ResetButton_Click" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
