<UserControl x:Class="OpenClick.App.Views.TesterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="4">
      <TextBlock x:Name="TitleText" Style="{StaticResource H1}" Margin="0,0,0,12"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock x:Name="DiagramTitle" Style="{StaticResource H2}" Margin="0,0,0,8"/>
          <Grid Height="170">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border x:Name="LeftZone" Grid.Column="0" CornerRadius="16,4,8,16" BorderThickness="2" Margin="20,10,2,30">
              <TextBlock x:Name="LeftLabel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="2,10,2,30">
              <Border x:Name="MiddleZone" CornerRadius="4" BorderThickness="2" Height="60">
                <TextBlock x:Name="MiddleLabel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="WheelZone" CornerRadius="8" BorderThickness="2" Height="52" Margin="20,6,20,0">
                <TextBlock x:Name="WheelLabel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </StackPanel>
            <Border x:Name="RightZone" Grid.Column="2" CornerRadius="4,16,16,8" BorderThickness="2" Margin="2,10,20,30">
              <TextBlock x:Name="RightLabel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="ListenButton" Click="ListenButton_Click" MinWidth="140"/>
            <Button x:Name="PauseButton" Click="PauseButton_Click" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
          </StackPanel>
          <TextBlock x:Name="HardwareNote" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock x:Name="CountersTitle" Style="{StaticResource H2}" Margin="0,0,0,8"/>
          <TextBlock x:Name="CountersText" Style="{StaticResource Body}"/>
          <TextBlock x:Name="TimingText" Style="{StaticResource Body}" Margin="0,6,0,0"/>
          <TextBlock x:Name="ScrollText" Style="{StaticResource Body}" Margin="0,6,0,0"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="StartSessionButton" Click="StartSessionButton_Click"/>
            <Button x:Name="CopySummaryButton" Click="CopySummaryButton_Click" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
            <Button x:Name="ResetCountersButton" Click="ResetCountersButton_Click" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
          </StackPanel>
          <TextBlock x:Name="SessionText" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="EventsTitle" Style="{StaticResource H2}"/>
            <Button x:Name="ClearEventsButton" Click="ClearEventsButton_Click" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Padding="8,2"/>
          </StackPanel>
          <ListBox x:Name="EventsList" Height="220" Margin="0,8,0,0" FontFamily="Consolas" FontSize="12"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
