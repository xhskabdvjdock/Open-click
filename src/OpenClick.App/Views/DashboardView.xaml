<UserControl x:Class="OpenClick.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="4">
      <TextBlock x:Name="TitleText" Style="{StaticResource H1}" Margin="0,0,0,12"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock x:Name="StatusLabel" Style="{StaticResource H2}"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Ellipse x:Name="StatusDot" Width="14" Height="14" Margin="0,0,8,0"/>
            <TextBlock x:Name="StatusDetail" Style="{StaticResource Body}" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="HookErrorText" Style="{StaticResource MutedText}" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" Visibility="Collapsed"/>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="ToggleButton" Click="ToggleButton_Click" MinWidth="150"/>
            <Button x:Name="BypassButton" Click="BypassButton_Click" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock x:Name="StatsTitle" Style="{StaticResource H2}" Margin="0,0,0,8"/>
          <UniformGrid Columns="3">
            <StackPanel Margin="0,0,12,8"><TextBlock x:Name="ObservedCap" Style="{StaticResource MutedText}"/><TextBlock x:Name="ObservedVal" Style="{StaticResource H2}"/></StackPanel>
            <StackPanel Margin="0,0,12,8"><TextBlock x:Name="SuppressedCap" Style="{StaticResource MutedText}"/><TextBlock x:Name="SuppressedVal" Style="{StaticResource H2}"/></StackPanel>
            <StackPanel Margin="0,0,0,8"><TextBlock x:Name="AllowedCap" Style="{StaticResource MutedText}"/><TextBlock x:Name="AllowedVal" Style="{StaticResource H2}"/></StackPanel>
            <StackPanel Margin="0,0,12,0"><TextBlock x:Name="ModeCap" Style="{StaticResource MutedText}"/><TextBlock x:Name="ModeVal" Style="{StaticResource Body}"/></StackPanel>
            <StackPanel Margin="0,0,12,0"><TextBlock x:Name="IntervalCap" Style="{StaticResource MutedText}"/><TextBlock x:Name="IntervalVal" Style="{StaticResource Body}"/></StackPanel>
            <StackPanel Margin="0,0,0,0"><TextBlock x:Name="ProfileCap" Style="{StaticResource MutedText}"/><TextBlock x:Name="ProfileVal" Style="{StaticResource Body}"/></StackPanel>
          </UniformGrid>
          <Button x:Name="ResetStatsButton" Click="ResetStatsButton_Click" Style="{StaticResource GhostButton}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock x:Name="ButtonsTitle" Style="{StaticResource H2}" Margin="0,0,0,8"/>
          <TextBlock x:Name="ButtonsDetail" Style="{StaticResource Body}"/>
          <TextBlock x:Name="TesterDetail" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
